# Postador — IA: a escolha de provedor e modelo é feita no PAINEL (seletor na tela Postador).
# As variáveis abaixo são opcionais e servem só de fallback quando o painel não envia (ex.: chamada direta à API).
# POSTADOR_IA_PROVIDER=openai
# POSTADOR_IA_MODEL_OPENAI=gpt-4o
# POSTADOR_IA_MODEL_CLAUDE=claude-sonnet-4-5-20250929

# Chaves de API (obrigatórias conforme o provedor que o cliente escolher no painel)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Imagen (Google) — imagens + Veo (vídeo Reels)
# GEMINI_API_KEY=...
# VEO_MODEL=veo-3.1-fast-generate-preview

# Vídeo Sora (OpenAI) — POST /api/postador/gerar-video provider=sora
# SORA_MODEL=sora-2
# POSTADOR_VIDEO_POLL_MS=8000
# POSTADOR_VIDEO_MAX_WAIT_MS=300000

# Imagem OpenAI — default dall-e-3; use gpt-image-1.5 se preferir
# OPENAI_IMAGE_MODEL=dall-e-3

# Texto no carrossel com IA (Nano Banana / Imagen edit): defina POSTADOR_CAROUSEL_TEXTO_IA=gemini para usar
# Gemini/Imagen para inserir texto nas imagens; senão usa Sharp (overlay SVG). Modelo padrão: imagen-3.0-capability-001.
# POSTADOR_CAROUSEL_TEXTO_IA=gemini
# POSTADOR_CAROUSEL_TEXTO_IA_MODEL=imagen-3.0-capability-001

# Site de imóveis: dentro do EasyPanel a API não resolve o host público (EAI_AGAIN). Obrigatório para "post por URL":
# SITE_IMOVEIS_INTERNAL_ORIGIN=http://NOME_DO_SERVICO_NO_EASYPANEL:PORTA
# Ex.: http://cmr-imobiliaria-site-imoveis:3000
# Opcional — se vazio, URLs cujo host contém "site-imoveis" e termina em .easypanel.host usam a origem interna automaticamente.
# SITE_IMOVEIS_PUBLIC_HOST=cmr-imobiliaria-site-imoveis.90qhxz.easypanel.host
# Vários hosts públicos: host1.com,host2.com

# Armazenamento de mídia do Postador (escolha um):
# - cloudinary (padrão): Cloudinary. Imagens > ~9,5 MB são redimensionadas/comprimidas para caber no limite free (10 MB).
# - local: self-hosted na própria API (data/uploads). Exige POSTADOR_MEDIA_BASE_URL e volume em data/ para persistir.
# POSTADOR_STORAGE=cloudinary
# POSTADOR_MEDIA_BASE_URL=https://sua-api.90qhxz.easypanel.host

# Cloudinary — URLs públicas estáveis (como no workflow n8n). Se POSTADOR_STORAGE não for "local", Cloudinary tem prioridade sobre MinIO.
# Use o mesmo cloud e preset da automação (ex.: preset n8nimage).
# CLOUDINARY_CLOUD_NAME=dakky1ulv
# CLOUDINARY_UPLOAD_PRESET=n8nimage

# MinIO — armazenamento de mídia do Postador (usado se POSTADOR_STORAGE=cloudinary e Cloudinary não estiver configurado).
# Dentro do EasyPanel a API não resolve o host público (getaddrinfo EAI_AGAIN). Use:
#   MINIO_INTERNAL_URL = URL interna do serviço MinIO (conexão do container)
#   MINIO_PUBLIC_URL   = URL pública (para os links que o Instagram vai baixar)
MINIO_INTERNAL_URL=http://cmr-imobiliaria-minio:9000
MINIO_PUBLIC_URL=https://cmr-imobiliaria-minio.90qhxz.easypanel.host
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=...
MINIO_BUCKET=crm
# Os arquivos do Postador ficam em crm/postador/... Se não usar EasyPanel, pode usar só MINIO_SERVER_URL.

# Banco: se definido, config (Instagram, empresa) e cronograma são gravados no PostgreSQL (tabelas app_config e postador_cronograma). Sem volume no EasyPanel.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Webhook n8n para disparar a raspagem de postagens (obrigatório para o botão Raspar).
# No EasyPanel use a URL INTERNA do app n8n (a API não resolve o domínio público de dentro do container):
# N8N_WEBHOOK_RASPAR_POSTAGENS=http://NOME_DO_APP_N8N:5678/webhook/raspar_postagens
# Ex.: se o app se chama "fabricaia-n8n" e a porta é 5678:
# N8N_WEBHOOK_RASPAR_POSTAGENS=http://fabricaia-n8n:5678/webhook/raspar_postagens
N8N_WEBHOOK_RASPAR_POSTAGENS=https://fabricaia-n8n.90qhxz.easypanel.host/webhook/raspar_postagens

# --- Login / workspace (organização + contas Instagram no PostgreSQL) ---
# Com DATABASE_URL, a API cria tabelas users, organizations, org_members, instagram_accounts.
# Defina um segredo forte em produção (gere com openssl rand -base64 48):
# JWT_SECRET=
# Após existir o primeiro usuário, novos cadastros ficam bloqueados no painel salvo:
# ALLOW_OPEN_REGISTER=true
# (Sem isso, a aba "Nova conta" aparece desabilitada com instrução para o administrador.)

# Segredo para n8n ler token do agente e prompts (GET /api/internal/agent-config). Header: X-Internal-Secret
# INTERNAL_AGENT_API_SECRET=
#
# Agente WhatsApp (Fase 1): GET /api/internal/whatsapp-agent-config?instance=...&phone=...
# Resolve organização, instância Evolution, lead, post de origem e prompt WA.
#
# Evolution Central (webhook → n8n). API key só no backend — nunca no painel.
# EVOLUTION_BASE_URL=https://infra-core-whatsapp-core.kxryyk.easypanel.host
# EVOLUTION_GLOBAL_API_KEY=
# N8N_WEBHOOK_WHATSAPP_EVOLUTION=https://infra-core-n8n-core.kxryyk.easypanel.host/webhook/whatsapp-evolution

# --- Conectar Instagram pelo painel (Facebook Login, app Meta da FabriaIA) ---
# ATENÇÃO: META_APP_* + redirect NÃO liberam clientes externos. Exige Verificação comercial +
# Revisão do app (Advanced Access) + modo Ao vivo no developers.facebook.com — ver docs/META-CLIENTES-PRODUCAO.md
# URL pública do painel (redirect após OAuth). Ex.: https://seu-painel.easypanel.host
# PAINEL_PUBLIC_URL=https://...
#
# App Meta: crie em developers.facebook.com. URL de redirecionamento OAuth (Instagram login da empresa OU Facebook Login):
# META_OAUTH_REDIRECT_URI=https://SUA-API.easypanel.host/api/auth/meta/callback
# META_APP_ID=
# META_APP_SECRET=
# Opcional: se o Instagram OAuth exigir outro client_id (raro). Senão omita — usa META_APP_ID.
# META_INSTAGRAM_CLIENT_ID=
# Use instagram se configurou o passo "login da empresa" no produto Instagram (URL incorporada instagram.com/oauth/authorize):
# META_OAUTH_MODE=instagram
# Se omitido, usa facebook (dialog facebook.com + /me/accounts).
# Se a Meta mostrar "Invalid platform app" no instagram.com/oauth, use META_OAUTH_MODE=facebook, adicione o produto
# "Facebook Login" ao MESMO app e coloque o MESMO redirect_uri nas URIs OAuth válidas.
# Opcional: versão Graph (padrão v21.0)
# META_GRAPH_VERSION=v21.0
# Opcional: escopos separados por vírgula (padrão inclui postagem + comentários + DM + business_management)
# META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_messages,business_management
# Opcional: segredo só para assinar o state do OAuth (padrão: reutiliza JWT_SECRET)
# META_OAUTH_STATE_SECRET=

# URLs de conformidade Meta (login da empresa → Configurações: desautorização e exclusão de dados)
# Desautorização — POST com signed_request:
# META_DEAUTH_URL → use https://SUA-API/api/auth/meta/deauthorize
# Exclusão de dados — GET (página) + POST (signed_request); resposta JSON com url + confirmation_code:
# META_DATA_DELETION_URL → use https://SUA-API/api/auth/meta/data-deletion
# E-mail exibido nas páginas de exclusão (opcional):
# META_DATA_DELETION_CONTACT_EMAIL=suporte@suaempresa.com
