{
  "name": "mcp-instagram-maquina-de-vendas",
  "version": "1.1.0",
  "private": true,
  "description": "MCP Instagram (Máquina de Vendas / Meta Graph API) para Claude Desktop e Cursor",
  "type": "module",
  "bin": {
    "mcp-instagram": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "start:bridge": "node scripts/mcp-stdio.mjs",
    "dev": "tsx src/http.ts",
    "dev:stdio": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
