{
  "mcpServers": {
    "instagram-maquina-de-vendas": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp-instagram-mcp.kxryyk.easypanel.host/mcp",
        "--transport",
        "http-only",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer COLE_MCP_API_KEY_DO_EASYPANEL"
      }
    }
  }
}
